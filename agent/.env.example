# ============================================================================
# Model provider — pick one of three
# ============================================================================
# claude_cli : Claude Code CLI (`claude -p`). NO API key needed, uses your
#              existing Claude Pro/Max session. Check: `claude --version`
# anthropic  : Anthropic API. Requires ANTHROPIC_API_KEY.
# openai     : OpenAI and ANY OpenAI-compatible endpoint — OpenRouter, Groq,
#              Together, DeepSeek, Google (OpenAI endpoint), Ollama, LM Studio,
#              vLLM…
LLM_PROVIDER=claude_cli

# Model name. If empty, claude_cli/anthropic default to claude-opus-5;
# REQUIRED for the openai provider (the valid name depends on the server).
LLM_MODEL=

# API key. LLM_API_KEY works for any provider; the standard names below are
# also read. claude_cli needs none of them.
LLM_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-...        # https://console.anthropic.com/settings/keys
# OPENAI_API_KEY=sk-...               # https://platform.openai.com/api-keys

# For LLM_PROVIDER=openai only. Empty means https://api.openai.com/v1
# Examples (the trailing /v1 matters on most of them):
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   DeepSeek    https://api.deepseek.com/v1
#   Together    https://api.together.xyz/v1
#   Google      https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama      http://localhost:11434/v1        (no key needed)
#   LM Studio   http://localhost:1234/v1         (no key needed)
LLM_BASE_URL=

# Time limit for a single model call, in seconds
LLM_TIMEOUT=300
# Token ceiling for a single response. Raise it if you see "response was cut off".
LLM_MAX_TOKENS=16000

# JSON schema enforcement (openai provider only).
#   auto   : tries json_schema -> json_object -> plain prompt, remembers what works
#   schema : force json_schema (OpenAI, most OpenRouter models)
#   object : json_object mode + schema in the system prompt
#   prompt : no enforcement, schema in the prompt only (weakest local models)
LLM_JSON_MODE=auto

# For LLM_PROVIDER=claude_cli only: name/path of the command
CLAUDE_CLI=claude

# ============================================================================
# Optional job sources (a source without its key disables itself)
# ============================================================================
# https://developer.adzuna.com/  (free tier)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# https://jooble.org/api/about  (free — recommended for Turkish postings)
# The host must match the region the key came from.
# For Turkish postings: https://tr.jooble.org (get the key there too)
JOOBLE_HOST=https://jooble.org
JOOBLE_API_KEY=

# ============================================================================
# Application
# ============================================================================
DB_PATH=./data/jobsearch.db
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# How many postings go to the LLM after the rule-based pre-filter.
# The defaults are picked to finish in one wave (32 / 8 = 4 batches, 4 concurrent).
# On a PAID provider, lowering LLM_SCORE_LIMIT is a direct saving.
LLM_SCORE_LIMIT=32
SCORE_BATCH_SIZE=8
MAX_CONCURRENCY=4
