# ============================================================================
# Model sağlayıcısı — üç seçenekten birini kullan
# ============================================================================
# claude_cli : Claude Code CLI (`claude -p`). API anahtarı GEREKMEZ, mevcut
#              Claude Pro/Max üyelik oturumunu kullanır. Kontrol: `claude --version`
# anthropic  : Anthropic API. ANTHROPIC_API_KEY gerekir.
# openai     : OpenAI ve OpenAI-uyumlu HER uç — OpenRouter, Groq, Together,
#              DeepSeek, Google (OpenAI uçu), Ollama, LM Studio, vLLM…
LLM_PROVIDER=claude_cli

# Model adı. Boş bırakılırsa claude_cli/anthropic için claude-opus-5 kullanılır;
# openai sağlayıcısında ZORUNLU (geçerli ad sunucuya göre değişiyor).
LLM_MODEL=

# API anahtarı. LLM_API_KEY her sağlayıcı için geçerli; istersen standart
# isimleri de kullanabilirsin (aşağıda). claude_cli'de hiçbiri gerekmez.
LLM_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-...        # https://console.anthropic.com/settings/keys
# OPENAI_API_KEY=sk-...               # https://platform.openai.com/api-keys

# Yalnızca LLM_PROVIDER=openai için. Boşsa https://api.openai.com/v1 kullanılır.
# Örnekler (çoğunda sonundaki /v1 önemli):
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   DeepSeek    https://api.deepseek.com/v1
#   Together    https://api.together.xyz/v1
#   Google      https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama      http://localhost:11434/v1        (anahtar gerekmez)
#   LM Studio   http://localhost:1234/v1         (anahtar gerekmez)
LLM_BASE_URL=

# Tek bir model çağrısının saniye cinsinden üst sınırı
LLM_TIMEOUT=300
# Tek yanıtın token tavanı. Yanıt "kesildi" hatası alırsan artır.
LLM_MAX_TOKENS=16000

# JSON şema zorlaması (yalnızca openai sağlayıcısı).
#   auto   : json_schema → json_object → düz istem sırasıyla dener, çalışanı hatırlar
#   schema : json_schema zorunlu (OpenAI, OpenRouter'ın çoğu modeli)
#   object : json_object kipi + şemayı sistem istemine yaz
#   prompt : hiçbir zorlama yok, şema yalnızca istemde (en zayıf yerel modeller)
LLM_JSON_MODE=auto

# Yalnızca LLM_PROVIDER=claude_cli için: komutun adı/yolu
CLAUDE_CLI=claude

# ============================================================================
# Opsiyonel iş ilanı kaynakları (anahtar yoksa o kaynak otomatik kapanır)
# ============================================================================
# https://developer.adzuna.com/  (ücretsiz tier)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# https://jooble.org/api/about  (ücretsiz — Türkiye ilanları için önerilir)
# Anahtar hangi bölgeden alındıysa host da o olmalı.
# Türkiye ilanları için: https://tr.jooble.org (anahtarı da oradan al)
JOOBLE_HOST=https://jooble.org
JOOBLE_API_KEY=

# ============================================================================
# Uygulama
# ============================================================================
DB_PATH=./data/jobsearch.db
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Kural bazlı ön elemeden sonra LLM'e kaç ilan gönderilsin.
# Varsayılanlar tek dalgada bitecek şekilde seçildi (32 / 8 = 4 parti, 4 eşzamanlı).
# ÜCRETLİ bir sağlayıcı kullanıyorsan LLM_SCORE_LIMIT'i düşürmek doğrudan tasarruf.
LLM_SCORE_LIMIT=32
SCORE_BATCH_SIZE=8
MAX_CONCURRENCY=4
